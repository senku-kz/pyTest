# Скопировать в .env и при необходимости поправить.
# БД-1 (источник)
SOURCE_DSN=postgresql://app:app@localhost:5442/source_db
# БД-2 (приёмник)
TARGET_DSN=postgresql://app:app@localhost:5443/target_db

# Настройки retry для соединения с БД-1
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.2

# Таймауты для БД-1 (мс)
STATEMENT_TIMEOUT_MS=3000
TCP_USER_TIMEOUT_MS=3000
